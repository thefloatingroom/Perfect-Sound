<index version="1" name="PerfectSound">

  <metadata>
    <description><![CDATA[
# Perfect Sound

Professional REAPER toolkit. Requires a valid Perfect Sound license.

Visit https://perfectsound.example to purchase a license. After install,
run any Perfect Sound action from the Action List - you will be prompted
for your email and password on first run.

All scripts are streamed from the licensing server, decrypted in memory,
and never written to disk. Installing a script without a valid license
will simply do nothing when run.
    ]]></description>
    <link rel="website">https://perfectsound.example</link>
  </metadata>

  <category name="Core">

    <reapack name="loader.lua" type="script" desc="Perfect Sound Loader (required)">
      <metadata>
        <description><![CDATA[
The Perfect Sound loader. Required by every Perfect Sound script.
Install this first.

On first run, prompts for the email and password tied to your license.
Credentials are cached locally encrypted with a hardware-bound key, so
copying the cache file to another machine does not transfer the license.
        ]]></description>
      </metadata>
      <version name="1.0.2" author="Perfect Sound" time="2026-05-20T15:43:30Z">
        <changelog><![CDATA[Dependency check: shows clear message if ReaImGui, SWS or js_ReaScriptAPI is missing.]]></changelog>
        <source main="true" file="loader.lua">https://raw.githubusercontent.com/thefloatingroom/Perfect-Sound/main/loader.lua</source>
      </version>
    </reapack>

  </category>

